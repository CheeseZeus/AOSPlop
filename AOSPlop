#!/usr/bin/env python3
# AOSPlop plops the LaydibugOS AOSP source tree onto your disk.
# yeah it's a python script. yeah it worked on my machine. good luck.
#
# (Pupperkinso f-472 SV LLF-D1 D186 · inaugural)

import os
import sys
import urllib.request

# Each OUTTIE: path we write to, URL we fetch from.
# Grows one at a time as the clean-license-audit resolves OUTTIEs on our end.
#
# TODO: scaffolding step. Before fetching any OUTTIE, run Google's `repo` tool
# to download the virgin-mary AOSP tree (android-15, revision 20). Each OUTTIE
# then overlays onto that scaffold. Deferred for now because full AOSP sync is
# a long download during iterative testing.
OUTTIES = [
    # FFmpeg · n8.0 · (b-vanilla) UPSTREAM-DIRECT · byte-verified during
    # D186 Pupperkinso FFmpeg bulk inch #2 (9,754-file sweep).
    {
        "path": "external/ffmpeg/LICENSE.md",
        "url": "https://raw.githubusercontent.com/FFmpeg/FFmpeg/n8.0/LICENSE.md",
    },
    {
        "path": "external/ffmpeg/Changelog",
        "url": "https://raw.githubusercontent.com/FFmpeg/FFmpeg/n8.0/Changelog",
    },
    {
        "path": "external/ffmpeg/Makefile",
        "url": "https://raw.githubusercontent.com/FFmpeg/FFmpeg/n8.0/Makefile",
    },
    {
        "path": "external/ffmpeg/MAINTAINERS",
        "url": "https://raw.githubusercontent.com/FFmpeg/FFmpeg/n8.0/MAINTAINERS",
    },
    {
        "path": "external/ffmpeg/.mailmap",
        "url": "https://raw.githubusercontent.com/FFmpeg/FFmpeg/n8.0/.mailmap",
    },
]


def plop(outtie):
    print(f"plop: fetching  {outtie['url']}")
    os.makedirs(os.path.dirname(outtie["path"]) or ".", exist_ok=True)
    with urllib.request.urlopen(outtie["url"]) as r, open(outtie["path"], "wb") as f:
        f.write(r.read())
    size = os.path.getsize(outtie["path"])
    print(f"plop: wrote     {outtie['path']}  ({size} bytes)")


def main():
    for o in OUTTIES:
        plop(o)
    print(f"plop: done. {len(OUTTIES)} file(s). good luck.")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"plop: failed. {type(e).__name__}: {e}", file=sys.stderr)
        sys.exit(1)
