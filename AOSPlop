# yeah it's a python script. yeah it worked on my machine. good luck.
#
# (Pupperkinso f-472 SV LLF-D1 D186 · inaugural)

import os
import sys
import urllib.request

# Each OUTTIE: path we write to, URL we fetch from.
# V1 ships exactly one. More will be added as the clean-license-audit resolves.
OUTTIES = [
    {
        "path": "external/ffmpeg/LICENSE.md",
        "url": "https://raw.githubusercontent.com/FFmpeg/FFmpeg/n8.0/LICENSE.md",
    },
]


def plop(outtie):
    print(f"plop: fetching  {outtie['url']}")
    os.makedirs(os.path.dirname(outtie["path"]) or ".", exist_ok=True)
    with urllib.request.urlopen(outtie["url"]) as r, open(outtie["path"], "wb") as f:
        f.write(r.read())
    size = os.path.getsize(outtie["path"])
    print(f"plop: wrote     {outtie['path']}  ({size} bytes)")


def main():
    for o in OUTTIES:
        plop(o)
    print(f"plop: done. {len(OUTTIES)} file(s). good luck.")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"plop: failed. {type(e).__name__}: {e}", file=sys.stderr)
        sys.exit(1)
