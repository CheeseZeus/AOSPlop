def plop(outtie):
    print(f"plop: fetching  {outtie['url']}")
    os.makedirs(os.path.dirname(outtie["path"]) or ".", exist_ok=True)
    with urllib.request.urlopen(outtie["url"]) as r:
        body = r.read()
    if outtie.get("base64"):
        body = base64.b64decode(body)
    with open(outtie["path"], "wb") as f:
        f.write(body)
    size = os.path.getsize(outtie["path"])
    print(f"plop: wrote     {outtie['path']}  ({size} bytes)")


def main():
    for o in OUTTIES:
        plop(o)
    print(f"plop: done. {len(OUTTIES)} file(s). good luck.")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"plop: failed. {type(e).__name__}: {e}", file=sys.stderr)
        sys.exit(1)
